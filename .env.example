# Copy to `.env` for local dev (this repo ignores `.env`).
#
# Local Development (SQLite)
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=dev-local-secret-key-change-me
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1,http://localhost
DJANGO_DB_ENGINE=sqlite

# Production (cPanel / MySQL) - set these as environment variables in cPanel
# (real environment variables override `.env` if both are present)
#
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
# DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
# DJANGO_DB_ENGINE=mysql
# DJANGO_DB_NAME=cpanel_db_name
# DJANGO_DB_USER=cpanel_db_user
# DJANGO_DB_PASSWORD=cpanel_db_password
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=3306

